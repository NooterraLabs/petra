petra 0

# Job 2: single-plate shear connection, W16x31 beam to a column flange.
# Three 3/4 in A325-N bolts (Group 120, threads included) in STD holes at 3 in pitch,
# 3/8 in A36 plate, 1/4 in E70 fillet welds both sides. Factored end reaction 45 kips (LRFD).
# Values NOT in the brief, chosen here: beam grade A992, column W14x90 A992,
# Lev 1.5 in, plate Leh 1.5 in, bolt line a = 3 in, beam Leh 1.75 in, top row 3 in below beam top.

shear_tab tab {
  basis lrfd
  beam W16x31 grade steel.A992
  support W14x90 flange grade steel.A992
  plate steel.A36 thickness 0.375 inch
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 3
  pitch 3 inch
  edge_vertical 1.5 inch
  plate_edge 1.5 inch
  bolt_line 3 inch
  beam_edge 1.75 inch
  top 3 inch
  weld electrode.E70 size 0.25 inch sides 2
}
