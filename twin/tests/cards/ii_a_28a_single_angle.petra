petra 0

# Companion Example II.A-28A. All-bolted single angle, W18x35 beam coped 2 in. deep by 4 in.
# long, to a W21x62 girder web. The beam web's edge below the cope is 1.5 in. as given.

single_angle ii_a_28a {
  basis lrfd
  beam W18x35 grade steel.A992
  support W21x62 web grade steel.A992
  angle L4x3x3_8 grade steel.A572_50 outstanding short
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 4
  pitch 3 inch
  edge_vertical 1.25 inch
  beam_edge 1.75 inch
  top 3.5 inch
  beam_gauge 2.5 inch
  support_side bolted
  support_gauge 1.75 inch
  cope top depth 2 inch length 4 inch
  setback 0.75 inch
}
