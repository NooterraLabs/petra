petra 0

design "gate-1-00185" {
  owner "gate@petra.dev"
}

weld_bracket c1 {
  basis lrfd
  plate steel.A36 thickness 0.75 inch
  support W14x61 flange grade steel.A992
  weld electrode.E70 size 0.3125 inch sides 2
  weld_length 10 inch
  eccentricity 5 inch
}

load gate {
  on c1 shear in [0 kip, 81.787 kip]
  on c1 cycles in [10000, 10000]
  signed "gate@petra.dev" source "steel gate generator"
}
