petra 0

# Steel gate design gate-1-03786. support_gauge runs from the angle's heel to the bolt line in the
# outstanding leg, so 5.5 in. on the 3.5 in. short leg puts that line 2 in. past the leg's toe.

design "gate-1-03786" {
  owner "gate@petra.dev"
}

single_angle c1 {
  basis asd
  beam W12x26 grade steel.A992
  support W12x65 flange grade steel.A992
  angle L4x3_1_2x3_8 grade steel.A36 outstanding short
  bolts bolt_group.150 diameter 0.75 inch threads excluded joint slip_critical surface class_a
  top 3 inch
  rows 2
  pitch 3 inch
  edge_vertical 1.25 inch
  beam_edge 1.75 inch
  beam_gauge 2 inch
  support_side bolted
  support_gauge 5.5 inch
}

load gate {
  on c1 shear in [0 kip, 0.001 kip]
  signed "gate@petra.dev" source "steel gate generator"
}
