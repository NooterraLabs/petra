petra 0

# Companion Example II.A-17A. Conventional single plate, W16x50 beam to a W14x90 column flange.

shear_tab ii_a_17a {
  basis lrfd
  beam W16x50 grade steel.A992
  support W14x90 flange grade steel.A992
  plate steel.A572_50 thickness 0.25 inch
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 4
  pitch 3 inch
  edge_vertical 1.25 inch
  plate_edge 1.5 inch
  bolt_line 3 inch
  weld electrode.E70 size 0.1875 inch sides 2
}

load reaction {
  on ii_a_17a shear in [0 kip, 49.6 kip]
}
