petra 0

# The lap of lap_pass under a pull of up to 60 kip, with no waivers. Three bolts carry
# 53.7 kip, so the strength cell is refuted at 60 kip. The plates hold: each yields at
# 72.9 kip, ruptures at 83.6 and tears out as a block at 87.4. One refuted cell is enough,
# and the verdict is FAIL.

plate tab {
  thickness 0.375 inch
  width 6 inch
  Fy given tab.Fy
  Fu given tab.Fu
}

plate strap {
  thickness 0.375 inch
  width 6 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.75 inch
  holes standard
  count 3
  pitch 3 inch
  end 1.5 inch
  side 3 inch
  surface protected
  joins tab strap
}
