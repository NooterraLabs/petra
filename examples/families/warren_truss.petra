petra 0

# Family: the two-panel Warren footbridge truss of truss_pass.petra (same nodes,
# members, sections and steel) under any downward load up to 28.5 kN at each top node.
# `petra certify-family` proves the three claims over the whole box once (R1, R2 and
# R4, with R3 force lemmas) and stores the evidence. A concrete truss whose two node
# loads sit inside the box, truss_pass.petra among them, reuses it.
#
# The truss is statically determinate, so the end diagonals carry
# N_ad = 0.9375 P_D + 0.3125 P_E, 1.25 P of compression at the worst vertex, plus
# 0.45 kN from the members' own weight (the tops of the registry's ranges for g and
# steel's density). The strength claim factors the load and not the weight, so it
# needs 1.5 x 1.25 P + 0.45 kN within the 53.98 kN EN 1993-1-1 compression resistance
# of a 2.5 m CHS 60.3x3.2 at E = 200 GPa. That is the 54.69 kN flexural buckling resistance
# (curve c), lowered by the member check of 6.3.3 for the bending of the diagonal's
# own weight. The box edge is 28.55 kN per node (tests/test_bench.py), so 28.5 kN
# certifies. Before the 6.3.3 check it was 28.93 kN, without the weight 29.17 kN,
# and against the bare Euler load of 74.12 kN, which v0 used before, 39.53 kN.

truss frame {
  material steel.S355
  section chs.60_3x3_2

  node A at (0 m, 0 m) support pinned
  node B at (3 m, 0 m)
  node C at (6 m, 0 m) support roller_x
  node D at (1.5 m, 2 m)
  node E at (4.5 m, 2 m)

  member bottom_ab: A -- B
  member bottom_bc: B -- C
  member top_de:    D -- E section chs.76_1x3_2
  member diag_ad:   A -- D
  member diag_db:   D -- B
  member diag_be:   B -- E
  member diag_ec:   E -- C
}
