petra 0

# A bought 50 x 30 mm board dropped into the printed tray. The board's maker signs its
# outline tolerance. The assembly says where each part sits and how the board arrives:
# straight down from 25 mm above its place. Coverage checks that it goes in at the worst
# corner of both tolerances and that it rests on the tray.
# Five print rules have no model yet (min_feature, thin_wall, min_hole, overhang and
# support_access), so the verdict is UNKNOWN until each is checked by hand and waived.

design "board-in-case" {
  owner "e.designer@example.org"
  environment indoor_dry
}

part case {
  mesh "case.stl" sha256 "b86411789c91981853e772444e368ef353ca9a5ce646b596202ed6dc4bc6dc5a" units mm
  material polymer.petg
  process process.print.fdm_petg_0_4
}

part board {
  mesh "board.stl" sha256 "5ac82cbab420f0ee38ced9bf67fe64d51c576127b40fc7cae78cafdbaa36cd97" units mm
  material polymer.pc
  tolerance in [0.1 mm, 0.1 mm] signed "e.designer@example.org" source "board maker's outline drawing"
}

assembly box {
  place case at (0 mm, 0 mm, 0 mm) facing top front
  place board at (5 mm, 5 mm, 2 mm) facing top front
  insert board along bottom from 25 mm
}
