petra 0

# A concentrated compressive force from a beam flange on a W14x90 column flange, away from
# the column ends. The panel zone (J10.6) is demanded at every flange force, and its check
# reads two loads the force alone does not give: the panel's required shear (the flange
# forces of the moment connections at the joint less the story shear) and the column's
# axial force. Neither is declared here, so the panel zone stays open (UNKNOWN) naming
# both: add `on ff1 panel_shear in [...]` and `on ff1 axial in [...]`, or a panel_shear of
# zero where the force is no flange of a moment connection.

flange_force ff1 {
  basis lrfd
  member W14x90 grade steel.A992
  bearing_length 0.5 inch
  location interior
  force_kind compressive
  flange_restrained yes
  unbraced_length 144 inch
  moment_at_force below_yield
}
