lola 0

# A shear tee: a WT6x25 bolted to the beam web through its stem and to the column flange
# through its flange.

design "steel-shear-tee" {
  owner "s.engineer@example.org"
}

shear_tee tee1 {
  basis lrfd
  beam W18x50 grade steel.A992
  support W14x90 flange grade steel.A992
  tee WT6x25 grade steel.A992
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 4
  pitch 3 inch
  edge_vertical 1.25 inch
  bolt_line 3 inch
  beam_edge 1.75 inch
  top 3 inch
  support_side bolted
  support_gauge 5.5 inch
}

load gravity {
  on tee1 shear in [0 kip, 40 kip]
  signed "s.engineer@example.org" source "beam reaction, LRFD 1.2D + 1.6L, calc SC-3"
}
