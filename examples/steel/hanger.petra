petra 0

# A tee hanger: a WT9x25 bolted to the bottom flange of a W18x50 with two rows of two 3/4 in
# Group 120 bolts, carrying a tension in its stem. Prying is checked by the T-stub model.

design "steel-hanger" {
  owner "s.engineer@example.org"
}

hanger h1 {
  basis lrfd
  tee WT9x25 grade steel.A992
  support W18x50 flange grade steel.A992
  bolts bolt_group.120 diameter 0.75 inch threads included joint pretensioned
  rows 2
  pitch 3 inch
  tee_gauge 4 inch
  edge_vertical 1.5 inch
}

load gravity {
  on h1 tension in [0 kip, 40 kip]
  signed "s.engineer@example.org" source "beam reaction, LRFD 1.2D + 1.6L, calc SC-3"
}
