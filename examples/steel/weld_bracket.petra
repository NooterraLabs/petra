petra 0

# An eccentrically loaded welded bracket: a 1/2 in A36 plate fillet-welded both sides to a
# column flange over 12 in, loaded 6 in from the weld line.

weld_bracket wb1 {
  basis lrfd
  plate steel.A36 thickness 0.5 inch
  support W14x90 flange grade steel.A992
  weld electrode.E70 size 0.3125 inch sides 2
  weld_length 12 inch
  eccentricity 6 inch
}
