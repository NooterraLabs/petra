petra 0

# An all-bolted double-angle connection: a W18x50 beam to a W14x90 column flange through
# two L4x3-1/2x3/8 angles, long legs outstanding, four 3/4 in Group 120 bolts in double
# shear through the beam web and four in single shear through each outstanding leg.

design "steel-double-angle" {
  owner "s.engineer@example.org"
}

double_angle da1 {
  basis lrfd
  beam W18x50 grade steel.A992
  support W14x90 flange grade steel.A992
  angles L4x3_1_2x3_8 grade steel.A36 outstanding long
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 4
  pitch 3 inch
  edge_vertical 1.25 inch
  beam_edge 1.75 inch
  top 3 inch
  beam_gauge 2 inch
  support_side bolted
  support_gauge 5.5 inch
}

load gravity {
  on da1 shear in [0 kip, 60 kip]
  signed "s.engineer@example.org" source "beam reaction, LRFD 1.2D + 1.6L, calc SC-3"
}
