petra 0

card "steel-shear-tab-cyclic" {
  owner "s.engineer@example.org"
}

load gravity {
  on st1 shear in [0 kip, 40 kip]
  signed "s.engineer@example.org" source "beam reaction, LRFD 1.2D + 1.6L, calc SC-3"
}

load crane {
  on st1 shear in [2 kip, 10 kip]
  on st1 cycles in [0, 500000]
  signed "s.engineer@example.org" source "runway reaction under the crane, service loads, 500,000 cycles, calc SC-7"
}
