petra 0

# Two-panel Warren truss, 6 m span. Statically determinate: 5 nodes, 7 members,
# 3 support restraints. Diagonals are 2.5 m long (a 3-4-5 triangle), so every
# length is rational and the kernel's equilibrium matrix is exact.

truss frame {
  material steel.S355
  section chs.60_3x3_2

  node A at (0 m, 0 m) support pinned
  node B at (3 m, 0 m)
  node C at (6 m, 0 m) support roller_x
  node D at (1.5 m, 2 m)
  node E at (4.5 m, 2 m)

  member bottom_ab: A -- B
  member bottom_bc: B -- C
  member top_de:    D -- E section chs.76_1x3_2
  member diag_ad:   A -- D
  member diag_db:   D -- B
  member diag_be:   B -- E
  member diag_ec:   E -- C
}
