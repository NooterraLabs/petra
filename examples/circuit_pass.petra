petra 0

# A 10 A lighting radial: B10 MCB, 18 m of 2.5 mm2 Cu/PVC clipped direct, a 75 degC
# lever terminal, and the luminaires. Coverage adds the insulation-rating temperature
# check, short circuit and overload protection to the two claims (the 3 % drop claim
# settles the 5 % coverage demand); the wire-to-terminal connection adds temperature
# and current port contracts.

circuit lighting {
  supply mains voltage 230 V fault_current given fault_current
  breaker cb1 part mcb.B10
  wire w1 cable cable.cu_pvc_2_5 length 18 m install install.clipped_direct
  terminal t1 part terminal.lever_4mm2_75C
  consumer lamps

  connect mains.out -> cb1.in
  connect cb1.out -> w1.a
  connect w1.b -> t1.wire
  connect t1.out -> lamps.in
}
