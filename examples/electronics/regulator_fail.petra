petra 0

# Two 1117 regulators, each wrong in a different way. The 5 V one runs from the 5 V USB
# rail, so it has no headroom for its dropout. The 3.3 V one takes 12 V down to 3.3 V at
# up to 300 mA, and its SOT-223 package cannot shed the heat: the junction passes its
# maximum temperature. Coverage demands both checks of every regulator, so neither
# needs a claim; the claim below bounds the junction temperature tighter still.

board power {
  supply usb voltage given usb_voltage capacity given usb_capacity
  supply dc12 voltage given dc12_voltage capacity given dc12_capacity
  regulator v5 part reg.ldo1117_5v0_sot223 from usb
  regulator v3 part reg.ldo1117_3v3_sot223 from dc12
  sink sensor from v5
  sink radio from v3
}
