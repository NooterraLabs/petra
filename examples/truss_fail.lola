lola 0

# Same truss as truss_pass.lola with the heavier crowd load from brief rev C.
# At factor 1.5 the end diagonal needs 112.5 kN in compression; its Euler load is
# about 78 kN, so the solver finds a collapse mechanism and the kernel checks the
# Farkas ray. Expected verdict: FAIL on frame/truss.plastic_collapse.

design "warren-footbridge-panel-rev-c" {
  owner "a.reviewer@example.org"
  environment indoor_dry
}

truss frame {
  material steel.S355
  section chs.60_3x3_2

  node A at (0 m, 0 m) support pinned
  node B at (3 m, 0 m)
  node C at (6 m, 0 m) support roller_x
  node D at (1.5 m, 2 m)
  node E at (4.5 m, 2 m)

  member bottom_ab: A -- B
  member bottom_bc: B -- C
  member top_de:    D -- E section chs.76_1x3_2
  member diag_ad:   A -- D
  member diag_db:   D -- B
  member diag_be:   B -- E
  member diag_ec:   E -- C
}

load crowd {
  on frame.D fy in [-60 kN, -40 kN]
  on frame.E fy in [-60 kN, -40 kN]
  signed "client.structures@example.org" source "brief rev C, section 3.2"
}

claim strength: frame.collapse_factor >= 1.5 under crowd
