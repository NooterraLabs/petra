petra 0

design "drop-on-waived-heat" {
  owner "e.designer@example.org"
  environment indoor_dry
}

ambient in [30 degC, 30 degC] signed "site.manager@example.org" source "site survey"

circuit lighting {
  supply mains voltage 230 V fault_current in [0 kA, 6 kA] signed "dno@example.org" source "DNO letter"
  breaker cb1 part mcb.B20
  wire w1 cable cable.cu_pvc_2_5 length 18.8 m install install.clipped_direct
  consumer lamps

  connect mains.out -> cb1.in
  connect cb1.out -> w1.a
  connect w1.b -> lamps.in
}

load lamp_draw {
  on lighting.lamps current in [20 A, 20 A]
  signed "e.designer@example.org" source "schedule"
}

claim drop: lighting.w1.voltage_drop <= 3 % under lamp_draw
waive wire.steady_temperature on lighting.w1 by "e.designer@example.org" reason "short duty"
waive wire.overload_protection on lighting.w1 by "e.designer@example.org" reason "short duty"
