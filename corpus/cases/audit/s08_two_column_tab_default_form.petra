petra 0
design "t05e_conv_2col_34" {
  owner "audit@example.org"
}
shear_tab c1 {
  basis lrfd
  beam W24x55 grade steel.A992
  support W14x90 flange grade steel.A992
  plate steel.A36 thickness 0.75 inch
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 5
  columns 2
  gauge 3 inch
  pitch 3 inch
  edge_vertical 1.5 inch
  plate_edge 1.5 inch
  bolt_line 3.5 inch
  beam_edge 1.75 inch
  top 4 inch
  weld electrode.E70 size 0.5 inch sides 2
}
load gravity {
  on c1 shear in [0 kip, 90 kip]
  signed "audit@example.org" source "audit"
}
