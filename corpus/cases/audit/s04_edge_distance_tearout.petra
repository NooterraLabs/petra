petra 0
design "t18_ext_leh_min" {
  owner "audit@example.org"
}
shear_tab c1 {
  basis lrfd
  beam W24x55 grade steel.A992
  support W14x90 web grade steel.A992
  plate steel.A36 thickness 0.25 inch
  form extended
  bolts bolt_group.120 diameter 0.75 inch threads excluded
  rows 5
  pitch 3 inch
  edge_vertical 2.5 inch
  plate_edge 1 inch
  bolt_line 9 inch
  beam_edge 1.75 inch
  top 4.5 inch
  weld electrode.E70 size 0.1875 inch sides 2
}
load gravity {
  on c1 shear in [0 kip, 25 kip]
  signed "audit@example.org" source "audit"
}
