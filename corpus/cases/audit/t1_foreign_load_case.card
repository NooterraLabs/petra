petra 0

card "foreign-load" {
  owner "a@example.org"
  environment indoor_dry
}

given capacity in [36 kN, 40 kN] measured "qa@example.org" source "x"

load lift {
  on hook force in [0 kN, 40 kN] mean 10 kN
  signed "ops@example.org" source "log"
}

claim strength:   frame.collapse_factor >= 1.5 under lift
claim stability:  frame.stability_factor >= 3 under lift
claim b1: frame.member(bottom_ab).buckling_utilisation <= 1 under lift
claim b2: frame.member(bottom_bc).buckling_utilisation <= 1 under lift
claim b3: frame.member(top_de).buckling_utilisation <= 1 under lift
claim b4: frame.member(diag_ad).buckling_utilisation <= 1 under lift
claim b5: frame.member(diag_db).buckling_utilisation <= 1 under lift
claim b6: frame.member(diag_be).buckling_utilisation <= 1 under lift
claim b7: frame.member(diag_ec).buckling_utilisation <= 1 under lift
claim overload: P(hook.utilisation > 1) <= 3/10 under lift
