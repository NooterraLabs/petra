petra 0

# Same truss as truss_pass.petra with the heavier crowd load from brief rev C.
# At factor 1.5 the end diagonal needs 112.5 kN in compression; its EN 1993-1-1
# buckling resistance is 54.7 to 56.9 kN (E from 200 to 210 GPa), a little less
# with its own weight's bending (6.3.3), so the solver finds a collapse mechanism
# and the kernel checks the Farkas ray.
# Expected verdict: FAIL on frame/truss.plastic_collapse.

truss frame {
  material steel.S355
  section chs.60_3x3_2

  node A at (0 m, 0 m) support pinned
  node B at (3 m, 0 m)
  node C at (6 m, 0 m) support roller_x
  node D at (1.5 m, 2 m)
  node E at (4.5 m, 2 m)

  member bottom_ab: A -- B
  member bottom_bc: B -- C
  member top_de:    D -- E section chs.76_1x3_2
  member diag_ad:   A -- D
  member diag_db:   D -- B
  member diag_be:   B -- E
  member diag_ec:   E -- C
}

waive truss.plastic_collapse on frame by "x" reason "y"
waive truss.global_stability on frame by "x" reason "y"
waive truss.member_buckling on frame.bottom_ab by "x" reason "y"
waive truss.member_buckling on frame.bottom_bc by "x" reason "y"
waive truss.member_buckling on frame.top_de by "x" reason "y"
waive truss.member_buckling on frame.diag_ad by "x" reason "y"
waive truss.member_buckling on frame.diag_db by "x" reason "y"
waive truss.member_buckling on frame.diag_be by "x" reason "y"
waive truss.member_buckling on frame.diag_ec by "x" reason "y"
