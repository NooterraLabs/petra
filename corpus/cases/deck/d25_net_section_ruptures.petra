petra 0

# The strap is 3 inch wide. A hole of 13/16 inch is taken 1/16 inch wider (B4.3b), so the net
# section is (3 - 7/8) x 0.375 = 0.797 inch2, and it ruptures at 0.75 x 58 x 0.797 = 34.66 kip.
# The pull is 35.5 kip, so rupture fails.
# The strap yields at 0.9 x 36 x 3 x 0.375 = 36.45 kip, which holds, and every other answer
# holds or is waived.

plate tab {
  thickness 0.375 inch
  width 6 inch
  Fy given tab.Fy
  Fu given tab.Fu
}

plate strap {
  thickness 0.375 inch
  width 3 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.75 inch
  holes standard
  count 3
  pitch 3 inch
  end 1.5 inch
  side 1.5 inch
  surface protected
  joins tab strap
}
