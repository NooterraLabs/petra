petra 0

# The yield stress of a plate reads the bound the card gives for its tensile strength.

plate tab {
  thickness 0.375 inch
  width 6 inch
  Fy given tab.Fu
  Fu given tab.Fy
}

plate strap {
  thickness 0.375 inch
  width 6 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.75 inch
  holes standard
  count 3
  pitch 3 inch
  end 1.5 inch
  side 3 inch
  surface protected
  joins tab strap
}
