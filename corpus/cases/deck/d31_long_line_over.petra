petra 0

# 14 bolts at 3 inch through 1 inch plates: a line of 39 inch, over 38. Note c of Table J3.2
# takes the shear stress at 83.3%, so a bolt carries 0.75 x 0.833 x 54 x 0.4418 = 14.90 kip and
# the 14 carry 208.7. The pull is 215 kip, so the strength fails.
# At the full stress the bolts would carry 250.5 kip and hold. Each plate yields at 324 kip
# and ruptures at 396.9.

plate tab {
  thickness 1 inch
  width 10 inch
  Fy given tab.Fy
  Fu given tab.Fu
}

plate strap {
  thickness 1 inch
  width 10 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.75 inch
  holes standard
  count 14
  pitch 3 inch
  end 1.5 inch
  side 5 inch
  surface protected
  joins tab strap
}
