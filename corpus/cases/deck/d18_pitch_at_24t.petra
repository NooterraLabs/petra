petra 0

# Painted 3/8 inch plates with a pitch of 9 inch: 24 thicknesses, the most J3.6(a) allows and
# not over it. Unpainted weathering steel would be allowed 5.25 inch.

plate tab {
  thickness 0.375 inch
  width 6 inch
  Fy given tab.Fy
  Fu given tab.Fu
}

plate strap {
  thickness 0.375 inch
  width 6 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.75 inch
  holes standard
  count 3
  pitch 9 inch
  end 1.5 inch
  side 3 inch
  surface protected
  joins tab strap
}
