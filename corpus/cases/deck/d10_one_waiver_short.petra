petra 0

# The card waives three of the five mechanisms the deck has no rule for. The bending of the plates stays open, and so does
# block shear of a block of fewer bolts than all.

plate tab {
  thickness 0.375 inch
  width 6 inch
  Fy given tab.Fy
  Fu given tab.Fu
}

plate strap {
  thickness 0.375 inch
  width 6 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.75 inch
  holes standard
  count 3
  pitch 3 inch
  end 1.5 inch
  side 3 inch
  surface protected
  joins tab strap
}
