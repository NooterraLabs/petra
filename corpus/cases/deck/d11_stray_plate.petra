petra 0

# A third plate that no lap joins. Nothing reads its thickness or its width, so nothing checks it.

plate tab {
  thickness 0.375 inch
  width 6 inch
  Fy given tab.Fy
  Fu given tab.Fu
}

plate strap {
  thickness 0.375 inch
  width 6 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.75 inch
  holes standard
  count 3
  pitch 3 inch
  end 1.5 inch
  side 3 inch
  surface protected
  joins tab strap
}

plate spare {
  thickness 0.000001 mm
  width 6 inch
  Fy given spare.Fy
  Fu given spare.Fu
}
