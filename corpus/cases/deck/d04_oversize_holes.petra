petra 0

# The end distance rule is for standard holes, and the deck has none for oversize ones.

plate tab {
  thickness 0.375 inch
  width 6 inch
  Fy given tab.Fy
  Fu given tab.Fu
}

plate strap {
  thickness 0.375 inch
  width 6 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.75 inch
  holes oversize
  count 3
  pitch 3 inch
  end 1.5 inch
  joins tab strap
}
