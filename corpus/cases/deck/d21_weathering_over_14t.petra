petra 0

# Unpainted A588 weathering steel, 3/8 inch thick, with a pitch of 5.5 inch. J3.6(b) allows 14
# thicknesses, 5.25 inch, and at most 7 inch. 5.5 > 5.25, so the spacing fails.
# Painted plates would be allowed 9 inch.

plate tab {
  thickness 0.375 inch
  width 6 inch
  Fy given tab.Fy
  Fu given tab.Fu
}

plate strap {
  thickness 0.375 inch
  width 6 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.75 inch
  holes standard
  count 3
  pitch 5.5 inch
  end 1.5 inch
  side 3 inch
  surface weathering
  joins tab strap
}
