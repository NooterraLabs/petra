petra 0

# Tables J3.3 and J3.4 list no 0.7 inch bolt. Every rule that reads the hole or the least edge
# distance of one is open, on six lines: the clear spacing, the end and side distances, the
# strength of the bolts and their holes, and the rupture and block shear of each plate.

plate tab {
  thickness 0.375 inch
  width 6 inch
  Fy given tab.Fy
  Fu given tab.Fu
}

plate strap {
  thickness 0.375 inch
  width 6 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.7 inch
  holes standard
  count 3
  pitch 3 inch
  end 1.5 inch
  side 3 inch
  surface protected
  joins tab strap
}
