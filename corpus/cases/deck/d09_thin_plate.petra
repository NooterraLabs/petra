petra 0

# The strap is 1/8 inch thick. Under a pull of 45 kip it yields at 0.9 x 36 x 6 x 0.125 = 24.3 kip,
# ruptures at 0.75 x 58 x 5.125 x 0.125 = 27.9 and tears out as a block at 29.1, and at its
# holes the three bolts carry 7.14 + 9.79 + 9.79 = 26.7.
# Its middle hole is also 3 inch from the nearest edge, over the 12 thicknesses, 1.5 inch, of
# J3.6. No rule checks that, and the card does not waive it.

plate tab {
  thickness 0.375 inch
  width 6 inch
  Fy given tab.Fy
  Fu given tab.Fu
}

plate strap {
  thickness 0.125 inch
  width 6 inch
  Fy given strap.Fy
  Fu given strap.Fu
}

lap splice {
  fastener "Group 120"
  threads included
  diameter 0.75 inch
  holes standard
  count 3
  pitch 3 inch
  end 1.5 inch
  side 3 inch
  surface protected
  joins tab strap
}
