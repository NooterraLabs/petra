petra 0

# An eccentrically loaded welded bracket: a 5/16 in A572 Gr 50 plate fillet-welded both sides
# (3/16 in E70) to the W12x40 column flange over 13 in, loaded 5 in from the weld line. ASD.

weld_bracket wb1 {
  basis asd
  plate steel.A572_50 thickness 0.3125 inch
  support W12x40 flange grade steel.A992
  weld electrode.E70 size 0.1875 inch sides 2
  weld_length 13 inch
  eccentricity 5 inch
}
