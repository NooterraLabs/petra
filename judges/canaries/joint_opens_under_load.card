petra 0

card "joint-opens" {
  owner "m.engineer@example.org"
  environment indoor_dry
}

given torque in [5 Nm, 10 Nm] signed "fitter.lead@example.org" source "assembly spec AS-12 rev C"
given nut_factor in [0.16, 0.2] measured "test.lab@example.org" source "torque-tension report TT-2026-031"
given load_share in [0.1, 0.2] signed "m.engineer@example.org" source "joint diagram calc JD-7"

load pull {
  on bracket force in [0 kN, 40 kN]
  signed "client.structures@example.org" source "lifting study LS-2"
}

claim tension: bracket.tension_utilisation <= 0.7 under pull

waive bolt.plate_bearing on bracket by "m.engineer@example.org" reason "plates checked by hand, calc PB-3"
