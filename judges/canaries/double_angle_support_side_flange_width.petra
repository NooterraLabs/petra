petra 0

# violates: steel.support_side.flange_width
# Design 1015 of `python scripts/absurd_gap.py --seed 1` at commit b9e9792 (docs/absurd_gap.md):
# support welds at the outstanding legs' toes: 8.355 in across, wider than the W12x40's 8.01 in flange.

design "absurd-01015" {
  owner "gate@petra.dev"
}

double_angle c1 {
  basis asd
  beam W18x50 grade steel.A992
  support W12x40 flange grade steel.A992
  angles L4x4x1_2 grade steel.A36 outstanding long
  bolts bolt_group.120 diameter 0.75 inch threads included
  top 2.5 inch
  rows 5
  pitch 3 inch
  edge_vertical 1.5 inch
  beam_edge 1.75 inch
  beam_gauge 2.75 inch
  support_side welded
  support_weld electrode.E70 size 0.375 inch
}

load gate {
  on c1 shear in [0 kip, 3.232 kip]
  signed "gate@petra.dev" source "steel gate generator"
}
