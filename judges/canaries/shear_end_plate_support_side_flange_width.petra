petra 0

# violates: steel.support_side.flange_width
# Design 56 of `python scripts/absurd_gap.py --seed 1` at commit b9e9792 (docs/absurd_gap.md):
# support bolt lines: 6.312 in across, wider than the W14x22's 5 in flange.

design "absurd-00056" {
  owner "gate@petra.dev"
}

shear_end_plate c1 {
  basis asd
  beam W18x50 grade steel.A992
  support W14x22 flange grade steel.A992
  plate steel.A36 thickness 0.25 inch
  plate_width 8 inch
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 4
  pitch 3 inch
  edge_vertical 1.25 inch
  support_gauge 5.5 inch
  weld electrode.E70 size 0.1875 inch sides 2
  cope top depth 4 inch length 4 inch
}

load gate {
  on c1 shear in [0 kip, 2.431 kip]
  signed "gate@petra.dev" source "steel gate generator"
}
