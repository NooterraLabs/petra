# violates: steel.support_side.web_width
# Design 498 of `python scripts/absurd_gap.py --seed 1` at commit b9e9792 (docs/absurd_gap.md):
# end plate: 12 in across, wider than the 8.88 in between the W10x49's flanges.

shear_end_plate c1 {
  basis asd
  beam W18x50 grade steel.A992
  support W10x49 web grade steel.A992
  plate steel.A36 thickness 0.375 inch
  plate_width 12 inch
  bolts bolt_group.150 diameter 1 inch threads included
  rows 3
  pitch 3 inch
  edge_vertical 1.5 inch
  support_gauge 3.5 inch
  weld electrode.E70 size 0.3125 inch sides 2
  weathering yes
}
