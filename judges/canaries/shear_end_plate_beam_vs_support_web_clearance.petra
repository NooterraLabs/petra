petra 0

# violates: steel.beam_vs_support.web_clearance
# Design 2942 of `python scripts/absurd_gap.py --seed 1` at commit b9e9792 (docs/absurd_gap.md):
# the W36x231's 16.5 in flange is wider than the 12.58 in between the W14x90's flanges, and its end, 0.25 in out, lies inside their tips at 7.03 in.

design "absurd-02942" {
  owner "gate@petra.dev"
}

shear_end_plate c1 {
  basis asd
  beam W36x231 grade steel.A992
  support W14x90 web grade steel.A992
  plate steel.A36 thickness 0.25 inch
  plate_width 8 inch
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 4
  pitch 3 inch
  edge_vertical 1.25 inch
  support_gauge 5.5 inch
  weld electrode.E70 size 0.1875 inch sides 2
}

load gate {
  on c1 shear in [0 kip, 6.225 kip]
  signed "gate@petra.dev" source "steel gate generator"
}
