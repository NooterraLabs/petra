petra 0

# violates: steel.support_side.web_fillet
# Design 6477 of `python scripts/absurd_gap.py --seed 1` at commit b9e9792 (docs/absurd_gap.md):
# tee flange: 8.02 in across, wider than the W10x49's 7.88 in flat web.

design "absurd-06477" {
  owner "gate@petra.dev"
}

shear_tee c1 {
  basis lrfd
  beam W18x50 grade steel.A992
  support W10x49 web grade steel.A992
  tee WT5x22_5 grade steel.A992
  bolts bolt_group.150 diameter 0.875 inch threads excluded
  top 2.5 inch
  rows 3
  pitch 3 inch
  edge_vertical 1.25 inch
  bolt_line 3 inch
  beam_edge 1.75 inch
  support_side bolted
  support_gauge 4 inch
  cope top depth 1 inch length 4 inch
  setback 0.5 inch
}

load gate {
  on c1 shear in [0 kip, 7.130 kip]
  signed "gate@petra.dev" source "steel gate generator"
}
