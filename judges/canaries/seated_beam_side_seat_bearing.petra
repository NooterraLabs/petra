petra 0

# violates: steel.beam_side.seat_bearing
# Design 369 of `python scripts/absurd_gap.py --seed 1` at commit b9e9792 (docs/absurd_gap.md):
# beam end 6 in off the support face, past the seat's outstanding leg, which projects 4 in.

design "absurd-00369" {
  owner "gate@petra.dev"
}

seated c1 {
  basis lrfd
  beam W14x90 grade steel.A992
  support W14x61 flange grade steel.A992
  angle L6x4x3_4 grade steel.A36 outstanding short
  seat_length 8 inch
  setback 6 inch
  support_side bolted
  bolts bolt_group.120 diameter 0.75 inch threads excluded
  rows 2
  pitch 3 inch
  edge_vertical 1.25 inch
  support_gauge 3.5 inch
  top_angle L4x4x1_4 grade steel.A36 outstanding long
}

load gate {
  on c1 shear in [0 kip, 1.268 kip]
  signed "gate@petra.dev" source "steel gate generator"
}
