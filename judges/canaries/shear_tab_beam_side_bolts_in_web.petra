petra 0

# violates: steel.beam_side.bolts_in_web
# Design 4784 of `python scripts/absurd_gap.py --seed 1` at commit b9e9792 (docs/absurd_gap.md):
# bottom bolt hole reaches 11.906 in below the W12x40's top, past its flat web, which ends at 10.4 in.

design "absurd-04784" {
  owner "gate@petra.dev"
}

shear_tab c1 {
  basis asd
  beam W12x40 grade steel.A992
  support W12x50 flange grade steel.A992
  plate steel.A572_50 thickness 0.3125 inch
  bolts bolt_group.120 diameter 0.75 inch threads excluded joint slip_critical surface class_b fillers one
  top 2.5 inch
  rows 4
  pitch 3 inch
  edge_vertical 1.5 inch
  plate_edge 2 inch
  bolt_line 3 inch
  beam_edge 1.5 inch
  weld electrode.E70 size 0.3125 inch sides 2
  cope both depth 1 inch length 4 inch bottom_depth 1.5 inch
  setback 0.5 inch
}

load gate {
  on c1 shear in [0 kip, 4.835 kip]
  signed "gate@petra.dev" source "steel gate generator"
}
