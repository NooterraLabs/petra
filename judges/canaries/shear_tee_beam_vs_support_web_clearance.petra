petra 0

# violates: steel.beam_vs_support.web_clearance
# Design 12860 of `python scripts/absurd_gap.py --seed 1` at commit b9e9792 (docs/absurd_gap.md):
# the W24x76's 8.99 in flange is wider than the 8.88 in between the W10x49's flanges, and its end, 2.5 in out, lies inside their tips at 4.83 in.

design "absurd-12860" {
  owner "gate@petra.dev"
}

shear_tee c1 {
  basis asd
  beam W24x76 grade steel.A992
  support W10x49 web grade steel.A992
  tee WT8x25 grade steel.A992
  bolts bolt_group.120 diameter 1 inch threads included joint slip_critical surface class_b
  holes support ssl
  top 3.5 inch
  rows 6
  pitch 3 inch
  edge_vertical 1.5 inch
  bolt_line 4 inch
  beam_edge 1.5 inch
  support_side welded
  support_weld electrode.E70 size 0.375 inch
}

load gate {
  on c1 shear in [0 kip, 10.908 kip]
  signed "gate@petra.dev" source "steel gate generator"
}
