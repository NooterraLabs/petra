 "rules": [
  {
   "id": "test/heat",
   "type": "strip",
   "mechanism": "strip.heat",
   "anchor": {
    "standard": "a deck made up for the tests",
    "clause": "1"
   },
   "says": "the current is at most what the strips carry warm",
   "where": [
    {
     "le": [
      [
       "add",
       "near.area",
       "far.area"
      ],
      [
       "q",
       "120",
       "mm2"
      ]
     ],
     "why": "the pads are at most 120 mm2 together"
    }
   ],
   "le": [
    [
     "load",
     "current"
    ],
    [
     "mul",
     "turns",
     [
      "row",
      "test/limit",
      {
       "w": "width"
      }
     ],
     [
      "row",
      "test/derate",
      {
       "T": "T"
      }
     ]
    ]
   ]
  },
  {
   "id": "test/hole",
   "type": "strip",
   "mechanism": "strip.hole",
   "anchor": {
    "standard": "a deck made up for the tests",
    "clause": "1"
   },
   "says": "the hole is at least the screw's",
   "le": [
    [
     "row",
     "test/drill",
     {
      "d": "screw",
      "fit": "fit"
     }
    ],
    "hole"
   ]
  },
  {
   "id": "test/bow",
   "type": "strip",
   "mechanism": "strip.bow",
   "anchor": {
    "standard": "a deck made up for the tests",
    "clause": "1"
   },
   "says": "the gap times what is left of 4 mm is at most 4.2 mm2",
   "le": [
    [
     "mul",
     "gap",
     [
      "sub",
      [
       "q",
       "4",
       "mm"
      ],
      "gap"
     ]
    ],
    [
     "q",
     "4.2",
     "mm2"
    ]
   ]
  },
  {
   "id": "test/spark",
   "type": "strip",
   "mechanism": "strip.spark",
   "anchor": {
    "standard": "a deck made up for the tests",
    "clause": "1"
   },
   "says": "the hole is at least 0.1 mm over the screw",
   "when": [
    "is",
    "fit",
    "free"
   ],
   "le": [
    [
     "add",
     "screw",
     [
      "q",
      "0.1",
      "mm"
     ]
    ],
    "hole"
   ]
  }
 ]
