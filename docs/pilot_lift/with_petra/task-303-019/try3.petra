petra 0

# Shear end plate for a W21x44 beam framing to the flange of a W12x65 column.
# Two lines of four 3/4 in Group 120 bolts (threads included), 1/4 in A572 Gr 50 plate
# 14-1/4 in long, 1/4 in E70 fillets both sides of the beam web.

design "task-303-019" {
  owner "task.owner@example.org"
}

shear_end_plate ep1 {
  basis lrfd
  beam W21x44 grade steel.A992
  support W12x65 flange grade steel.A992
  plate steel.A572_50 thickness 0.25 inch
  plate_width 5.5 inch
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 4
  pitch 3.5 inch
  edge_vertical 1.875 inch
  support_gauge 3.5 inch
  weld electrode.E70 size 0.25 inch sides 2
}

load gravity {
  on ep1 shear in [0 kip, 139.063 kip]
  signed "task.owner@example.org" source "task 303-019"
}
