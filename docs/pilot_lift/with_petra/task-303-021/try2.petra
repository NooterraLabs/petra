petra 0

design "task-303-021-bolt-bracket" {
  owner "task.owner@example.org"
}

bolt_bracket bb1 {
  basis asd
  plate steel.A572_50 thickness 0.3125 inch
  support W12x40 flange grade steel.A992
  bolts bolt_group.120 diameter 0.875 inch threads included
  rows 5
  columns 2
  pitch 2.5 inch
  gauge 3.5 inch
  eccentricity 8 inch
  edge_vertical 1.625 inch
  plate_edge 1.375 inch
}

load service {
  on bb1 shear in [0 kip, 39.889 kip]
  signed "task.owner@example.org" source "task 303-021"
}
