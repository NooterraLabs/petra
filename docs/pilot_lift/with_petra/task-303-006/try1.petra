petra 0

# Task 303-006: W18x35 beam to the web of a W10x49 column, single-plate shear connection, ASD.

design "task-303-006-shear-tab" {
  owner "task.owner@example.org"
}

shear_tab st1 {
  basis asd
  beam W18x35 grade steel.A992
  support W10x49 web grade steel.A992
  plate steel.A572_50 thickness 0.25 inch
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 5
  pitch 3 inch
  edge_vertical 1.5 inch
  plate_edge 1.5 inch
  bolt_line 3 inch
  beam_edge 2.5 inch
  setback 0.5 inch
  top 3 inch
  weld electrode.E70 size 0.1875 inch sides 2
}

load service {
  on st1 shear in [0 kip, 45.988 kip]
  signed "task.owner@example.org" source "task 303-006"
}
