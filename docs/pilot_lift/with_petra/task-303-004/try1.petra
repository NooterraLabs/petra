petra 0

design "task-303-004-bolt-bracket" {
  owner "task.owner@example.org"
}

bolt_bracket bb1 {
  basis asd
  plate steel.A572_50 thickness 0.5 inch
  support W12x65 flange grade steel.A992
  bolts bolt_group.120 diameter 0.875 inch threads included
  rows 5
  columns 2
  pitch 3 inch
  gauge 5.5 inch
  eccentricity 6 inch
  edge_vertical 1.5 inch
  plate_edge 1.5 inch
}

load service {
  on bb1 shear in [0 kip, 88.107 kip]
  signed "task.owner@example.org" source "task 303-004"
}
