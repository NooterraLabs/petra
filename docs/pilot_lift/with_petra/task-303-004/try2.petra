petra 0

design "task-303-004-bolt-bracket" {
  owner "task.owner@example.org"
}

bolt_bracket bb1 {
  basis asd
  plate steel.A572_50 thickness 0.25 inch
  support W12x65 flange grade steel.A992
  bolts bolt_group.150 diameter 0.75 inch threads included
  rows 6
  columns 2
  pitch 4.25 inch
  gauge 4 inch
  eccentricity 6 inch
  edge_vertical 1.75 inch
  plate_edge 1.25 inch
}

load service {
  on bb1 shear in [0 kip, 88.107 kip]
  signed "task.owner@example.org" source "task 303-004"
}
