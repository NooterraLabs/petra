petra 0

# Tee hanger under the bottom flange of a W16x31, ASD, 34.745 kip service tension.

design "task-303-005-hanger" {
  owner "task.owner@example.org"
}

hanger h1 {
  basis asd
  tee WT8x15_5 grade steel.A992
  support W16x31 flange grade steel.A992
  bolts bolt_group.120 diameter 0.625 inch threads included joint pretensioned
  rows 2
  pitch 2.375 inch
  tee_gauge 2.5625 inch
  edge_vertical 1.125 inch
}

load service {
  on h1 tension in [0 kip, 34.745 kip]
  signed "task.owner@example.org" source "task 303-005"
}
