petra 0

# A shear tee: a WT6x13 bolted to the W12x26 beam web through its stem and to the W10x49
# column flange through its flange. Two rows of 3/4 in A325-N bolts, snug-tight, standard holes.
# The stem bolts are checked for eccentricity e = a = 3.5 in; the beam end sits 1.25 in off the
# column face.

design "steel-shear-tee" {
  owner "task.owner@example.org"
}

shear_tee tee1 {
  basis asd
  beam W12x26 grade steel.A992
  support W10x49 flange grade steel.A992
  tee WT6x13 grade steel.A992
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 2
  pitch 4 inch
  edge_vertical 1.75 inch
  bolt_line 3.5 inch
  beam_edge 2.25 inch
  top 3 inch
  support_side bolted
  support_gauge 3.75 inch
  setback 1.25 inch
}

load service {
  on tee1 shear in [0 kip, 9.817 kip]
  signed "task.owner@example.org" source "task 303-018"
}
