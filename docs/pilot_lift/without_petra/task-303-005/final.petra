petra 0

# A tee hanger: a WT8x15.5 bolted to the bottom flange of a W16x31 with three rows of two 3/4 in
# Group 120 bolts, carrying a tension in its stem. The WT is cut from the support's own section, so
# the two flanges match (bf 5.53 in, tf 0.44 in) and the bolts sit at the W16x31's 3-1/2 in workable
# gauge. Tee length 7.5 in. Prying in both flanges is checked by the T-stub model, p = 2.5 in.

design "steel-hanger" {
  owner "task.owner@example.org"
}

hanger h1 {
  basis asd
  tee WT8x15_5 grade steel.A992
  support W16x31 flange grade steel.A992
  bolts bolt_group.120 diameter 0.75 inch threads included joint pretensioned
  rows 3
  pitch 2.5 inch
  tee_gauge 3.5 inch
  edge_vertical 1.25 inch
}

load service {
  on h1 tension in [0 kip, 34.745 kip]
  signed "task.owner@example.org" source "task 303-005"
}
