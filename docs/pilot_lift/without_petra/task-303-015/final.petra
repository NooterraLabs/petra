petra 0

# A single-angle connection: one L4x4x1/4, 15-1/2 in long, A36, bolted to the W24x55 web and to the
# W14x61 flange with five 3/4 in A325-N bolts in standard holes on each leg, snug-tight. ASD.

design "steel-single-angle" {
  owner "task.owner@example.org"
}

single_angle sa1 {
  basis asd
  beam W24x55 grade steel.A992
  support W14x61 flange grade steel.A992
  angle L4x4x1_4 grade steel.A36 outstanding long
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 5
  pitch 3 inch
  edge_vertical 1.75 inch
  beam_edge 1.75 inch
  top 3.5 inch
  beam_gauge 2.25 inch
  support_side bolted
  support_gauge 2.25 inch
  setback 0.5 inch
}

load gravity {
  on sa1 shear in [0 kip, 39.449 kip]
  signed "task.owner@example.org" source "task 303-015"
}
