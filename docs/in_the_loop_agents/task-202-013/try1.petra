petra 0

# Task 202-013: an all-bolted double-angle connection, a W16x26 beam to the web of a
# W10x49, through two L4x3x3/8 angles, short legs outstanding to fit between the
# support's flanges, three 3/4 in Group 120 bolts per line.

design "task-202-013" {
  owner "task.owner@example.org"
}

double_angle da1 {
  basis lrfd
  beam W16x26 grade steel.A992
  support W10x49 web grade steel.A992
  angles L4x3x3_8 grade steel.A36 outstanding short
  bolts bolt_group.120 diameter 0.75 inch threads included
  rows 3
  pitch 3 inch
  edge_vertical 1.25 inch
  beam_edge 2 inch
  top 3 inch
  beam_gauge 2.5 inch
  support_side bolted
  support_gauge 3.75 inch
  setback 0.5 inch
}

load gravity {
  on da1 shear in [0 kip, 29.356 kip]
  signed "task.owner@example.org" source "task 202-013"
}
