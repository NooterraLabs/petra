petra 0

# Single-plate shear connection: a W27x84 beam framing into the web of a W12x40
# through a 3/8 in A36 plate, seven 7/8 in Group 120 bolts (threads in the shear
# plane), the plate fillet-welded to the support web both sides.

design "task-202-001" {
  owner "task.owner@example.org"
}

shear_tab st1 {
  basis lrfd
  beam W27x84 grade steel.A992
  support W12x40 web grade steel.A992
  plate steel.A36 thickness 0.375 inch
  bolts bolt_group.120 diameter 0.875 inch threads included
  rows 7
  pitch 3 inch
  edge_vertical 1.5 inch
  plate_edge 1.75 inch
  bolt_line 3 inch
  beam_edge 2 inch
  top 4 inch
  weld electrode.E70 size 0.25 inch sides 2
}

load gravity {
  on st1 shear in [0 kip, 106.133 kip]
  signed "task.owner@example.org" source "task 202-001"
}
