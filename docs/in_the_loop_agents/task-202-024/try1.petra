petra 0

# Task 202-024: a tee hanger bolted to the flange of a W18x35, ASD.

design "task-202-024-hanger" {
  owner "task.owner@example.org"
}

hanger h1 {
  basis asd
  tee WT9x25 grade steel.A992
  support W18x35 flange grade steel.A992
  bolts bolt_group.120 diameter 0.75 inch threads included joint pretensioned
  rows 2
  pitch 3.5 inch
  tee_gauge 3.5 inch
  edge_vertical 1.5 inch
}

load service {
  on h1 tension in [0 kip, 28.62 kip]
  signed "task.owner@example.org" source "task 202-024"
}
