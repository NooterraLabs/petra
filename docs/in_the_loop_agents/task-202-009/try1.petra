petra 0

# Task 202-009: a stiffened seated connection, ASD, for a W24x55 beam on a W12x50 column flange.

design "task-202-009-stiffened-seat" {
  owner "task.owner@example.org"
}

stiffened_seat ss1 {
  basis asd
  beam W24x55 grade steel.A992
  support W12x50 flange grade steel.A992
  plate steel.A36 thickness 0.375 inch
  stiffener steel.A36 thickness 0.625 inch
  stiffener_width 6 inch
  stiffener_length 16 inch
  setback 0.5 inch
  weld electrode.E70 size 0.3125 inch sides 2
  top_angle L4x4x1_4 grade steel.A36 outstanding long
}

load gravity {
  on ss1 shear in [0 kip, 55.727 kip]
  signed "task.owner@example.org" source "task 202-009"
}
